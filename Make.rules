# -*- Mode: Makefile -*-

UV_RUN := uv run
PYTHON_VERSION := $(shell cat $(ROOT_DIR)/.python-version)

# The hook runs pre-commit through `uv run`, so it uses the `.venv` of
# whichever machine it runs on; `.git/hooks` is shared by every machine
# that syncs the checkout, so it holds no interpreter path.
#
.git/hooks/pre-commit: Make.rules
	@printf '%s\n' '#!/usr/bin/env bash' \
	  'exec uv run --quiet pre-commit hook-impl --config=.pre-commit-config.yaml --hook-type=pre-commit --hook-dir "$$(cd "$$(dirname "$$0")" && pwd)" -- "$$@"' > $@
	@chmod +x $@
	@echo "pre-commit hook installed"

clean::
	@find $(ROOT_DIR) -name \*~ -exec rm '{}' +
	@find $(ROOT_DIR) -name \*.pyc -exec rm '{}' +
	@find $(ROOT_DIR) -name __pycache__ -prune -exec rm -fr '{}' +
	@rm -rf build dist *.egg-info .ruff_cache .mypy_cache
	@rm -rf .venv

$(ROOT_DIR)/.venv: pyproject.toml uv.lock $(ROOT_DIR)/.python-version
	@uv sync
	@touch $@

.venv:: $(ROOT_DIR)/.venv

squeegee: .venv ruff-format mypy
	@$(UV_RUN) ruff check app/ importers/

lint: .venv .git/hooks/pre-commit
	@$(UV_RUN) pre-commit run -a

PY_FILES=$(shell find $(ROOT_DIR)/app/ $(ROOT_DIR)/importers/ -type f -name '*.py' 2>/dev/null)

.ruff_formatted: $(PY_FILES) .venv
	@$(UV_RUN) ruff format app/ importers/
	@touch .ruff_formatted

ruff-format: .ruff_formatted

mypy: .venv
	@$(UV_RUN) mypy app/ importers/

# Set the Make variable `VERSION` to the version in pyproject.toml
version: .venv	## Print the project version from pyproject.toml
	$(eval VERSION := $(shell $(UV_RUN) python -c "import tomllib; print(tomllib.load(open('$(ROOT_DIR)/pyproject.toml', 'rb'))['project']['version'])"))
	@echo "Version: $(VERSION)"

.PHONY: version
