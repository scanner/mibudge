# mibudge local development environment.
#
# `make env` (and `make up`, `make test`, `make lint`) writes this file to
# .env at the repository root when .env does not exist, replacing @HOSTNAME@
# with this machine's `hostname`.  .env belongs to one host: keep it out of
# any file sync shared between machines.
#
# One .env serves both ways of running the code:
#   - Tools on the host (`uv run manage.py`, pytest, mypy) read it through
#     config/settings.py and reach the services on their published
#     localhost ports.
#   - docker compose loads it into every app container and overrides the
#     service URLs with the docker-internal hostnames (see the root
#     docker-compose.yml).
#
# Add your own per-host settings (importer paths, 1Password URLs, ...) at
# the bottom; `make env` never overwrites an existing .env.

# This host
# ------------------------------------------------------------------------------
# The TLS certificate for this host is deployment/ssl/<DEV_HOSTNAME>-ssl_crt.pem
# (and -ssl_key.pem), created by `make certs` with mkcert.
DEV_HOSTNAME=@HOSTNAME@
SITE_URL=https://@HOSTNAME@:8000
ALLOWED_HOSTS=@HOSTNAME@,localhost,127.0.0.1,0.0.0.0

# General
# ------------------------------------------------------------------------------
DEBUG=True
DJANGO_SECRET_KEY=local-dev-secret-key-not-for-production
DJANGO_ADMIN_URL=admin/
ADMINISTRATIVE_EMAIL_ADDRESS=admin@example.com
TIME_ZONE=America/Los_Angeles

# django-fernet-encrypted-fields: salt for the field encryption key.
SALT_KEY=local-dev-salt-key-not-for-production

# PostgreSQL (published on localhost:6432)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://debug:debug@localhost:6432/mibudge

# Redis (published on localhost:7379)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:7379/0
CELERY_BROKER_URL=redis://localhost:7379/1
CELERY_RESULT_BACKEND=redis://localhost:7379/2
CELERY_FLOWER_USER=debug
CELERY_FLOWER_PASSWORD=debug

# Email: Mailpit (SMTP on localhost:1025, web UI on http://localhost:8025)
# ------------------------------------------------------------------------------
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False

# Sentry (off unless set)
# ------------------------------------------------------------------------------
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
